# Local development: start PostgreSQL with `docker compose up -d db`.
DATABASE_URL=postgresql://blockpulse:blockpulse_dev@localhost:5432/blockpulse
REQUIRE_DATABASE=true
DB_SSL=false
PG_POOL_SIZE=8

# Google AI Studio Gemini API key. Keep this only on the server.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=30000
AI_REQUESTS_PER_MINUTE=6

# Bitcoin data provider and refresh interval.
MEMPOOL_API_BASE=https://mempool.space/api
MEMPOOL_TIMEOUT_MS=10000
REFRESH_INTERVAL_MS=20000
PORT=4000
NODE_ENV=development
